From fbc8fc578734387e8230de77da6e5bfa1a902bfd Mon Sep 17 00:00:00 2001
From: Tifa Chen <tifa.chen@technexion.com>
Date: Mon, 19 May 2025 01:51:23 -0700
Subject: [PATCH] hciattach_rome: fix implicit declaration error on styhead 5.1

Upstream-Status: Pending
---
 tools/hciattach_rome.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)
 mode change 100755 => 100644 tools/hciattach_rome.c

diff --git a/tools/hciattach_rome.c b/tools/hciattach_rome.c
old mode 100755
new mode 100644
index 4cd4cd6..c219dd4
--- a/tools/hciattach_rome.c
+++ b/tools/hciattach_rome.c
@@ -77,6 +77,7 @@ unsigned char wait_vsc_evt = TRUE;
 /*****************************************************************************
 **   Functions
 *****************************************************************************/
+int read_bd_address(unsigned char *bdaddr);
 
 /*******************************************************************************
 **
@@ -1022,7 +1023,7 @@ int rome_get_tlv_file(char *file_path)
 
             /* Write BD Address */
             if(nvm_ptr->tag_id == TAG_NUM_2) {
-                if(read_bd_address(&bdaddr) == 0)
+                if(read_bd_address(bdaddr) == 0)
                     memcpy(nvm_byte_ptr, bdaddr, 6);
                 else
                     memcpy(nvm_byte_ptr, bd_addr, 6);
@@ -1707,7 +1708,7 @@ int read_bd_address(unsigned char *bdaddr)
       data[NVITEM], data[RDWR_PROT], data[NVITEM_SIZE]);
   else {
     fprintf(stderr, "%s: Read from persist memory failed : Programming default"
-      " BD ADDR\n");
+      " PERSIST HEADER\n",  __func__);
     close(fd);
     return -1;
   }
@@ -1726,7 +1727,7 @@ int read_bd_address(unsigned char *bdaddr)
       data[1], data[2], data[3], data[4], data[5]);
   else {
     fprintf(stderr, "%s: Read from persist memory failed : Programming default"
-      " BD ADDR\n");
+      " BD ADDR\n",  __func__);
     close(fd);
     return -1;
   }
-- 
